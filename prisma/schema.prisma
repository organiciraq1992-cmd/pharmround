// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/* ------------------------------------------------------------------
   PharmRound — Clinical Ward Round Pharmacy

   Inventory  : admin-managed hospital drug catalogue (read-only
                source pool the pharmacist draws ward items from)
   WardDrug  : user-curated list of drugs for a specific ward
   Patient    : a patient recorded during a ward round
   PatientDrug: a prescribed drug (qty) attached to a patient
------------------------------------------------------------------- */

model Inventory {
  id        String   @id @default(cuid())
  name      String   @unique
  form      String // "tab" | "fluid" | "supply"
  createdAt DateTime @default(now())
}

model WardDrug {
  id        String   @id @default(cuid())
  name      String
  custom    Boolean  @default(false) // true = not from inventory
  form      String // "tab" | "fluid" | "supply"
  createdAt DateTime @default(now())
  drugs     PatientDrug[]

  @@index([name])
}

model Patient {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  drugs     PatientDrug[]
}

model PatientDrug {
  id        String @id @default(cuid())
  patientId String
  drugId    String
  quantity  Int

  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  wardDrug   WardDrug  @relation(fields: [drugId], references: [id], onDelete: Cascade)

  @@unique([patientId, drugId])
  @@index([patientId])
  @@index([drugId])
}
